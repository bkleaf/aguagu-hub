# ======================
# aguagu-hub 환경변수 설정
# 이 파일을 .env로 복사한 후 실제 값을 입력하세요
# ======================

# 앱 포트 (기본값: 8080)
APP_PORT=8080

# PostgreSQL 데이터베이스
DB_URL=jdbc:postgresql://호스트:포트/데이터베이스명
DB_USERNAME=사용자명
DB_PASSWORD=비밀번호

# Telegram Bot
TELEGRAM_BOT_TOKEN=봇토큰
TELEGRAM_CHAT_ID=채팅ID
TELEGRAM_ENABLED=true
TELEGRAM_WEBHOOK_URL=https://your-domain/api/v1/telegram/webhook

# JVM 메모리 설정 (NAS 가용 메모리에 맞게 조절)
JAVA_OPTS=-Xmx512m
