### 자동결제 등록 - 넷플릭스 (삼성카드 4300)
POST {{host}}/api/v1/card/auto-payments
Content-Type: application/json

{
  "creditCardId": "SAMSUNG_4300",
  "description": "넷플릭스",
  "amount": 17000,
  "paymentDay": 15,
  "active": true
}

